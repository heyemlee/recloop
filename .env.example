# Copy to .env to override. The Makefile reads .env if it exists; these are the defaults.
# Keep the values unquoted (the file is also included by make).
RECLOOP_PG_PORT=15432
DATABASE_URL=postgres://recloop:recloop@localhost:15432/recloop?sslmode=disable
# Redis: state (user state, dedup markers, frequency caps, spend; noeviction, 1 GB) and cache
# (result pages, candidate cache; allkeys-lru, 384 MB). The api needs both; never point
# CACHE_REDIS_URL at the state instance (pages would fill it).
RECLOOP_REDIS_PORT=16390
REDIS_URL=redis://localhost:16390/0
RECLOOP_CACHE_REDIS_PORT=16391
CACHE_REDIS_URL=redis://localhost:16391/0
RECLOOP_REDIS_MAXMEMORY=1gb
RECLOOP_REDIS_MEMORY_LIMIT=1536m
# Online services (M1): the Go api, the gRPC model server (and its admin port) and the Next.js app.
API_PORT=18080
MODEL_SERVER_PORT=18081
MODEL_SERVER_ADMIN_PORT=18082
WEB_PORT=13000
# M2: event log, monitoring, tracing, bench profile (deploy/docker-compose.yml).
RECLOOP_KAFKA_PORT=19092
KAFKA_BROKERS=localhost:19092
RECLOOP_REDPANDA_ADMIN_PORT=19644
RECLOOP_LOG_SINK_PORT=14195
RECLOOP_AGGREGATOR_PORT=18090
# M3: billing's metrics and the Toxiproxy API in front of its PostgreSQL connection.
RECLOOP_BILLING_PORT=18092
RECLOOP_PG_PROXY_PORT=18475
RECLOOP_PROMETHEUS_PORT=19090
RECLOOP_GRAFANA_PORT=13001
RECLOOP_JAEGER_PORT=16686
RECLOOP_OTLP_GRPC_PORT=14317
RECLOOP_OTLP_HTTP_PORT=14318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14317
RECLOOP_BENCH_API_PORT=18180
RECLOOP_BENCH_MS_ADMIN_PORT=18182
RECLOOP_TOXIPROXY_PORT=18474
# Shopping assistant (M6): its service (POST /v1/chat; the web app proxies /api/v1/chat to it).
# RECLOOP_AGENT_MODEL empty = the rules parser, no API calls; a Claude model id (e.g.
# claude-opus-5-5) needs ANTHROPIC_API_KEY, which goes in .env only, never in this file.
AGENT_PORT=18083
RECLOOP_AGENT_URL=http://127.0.0.1:18083
RECLOOP_AGENT_MODEL=
# Ads (M3): ad_token HMAC keys as kid:secret[,kid:secret...]; the first signs, all verify. This
# value is for local development only; generate real ones with `openssl rand -base64 48`.
AD_TOKEN_KEYS=dev1:recloop-dev-only-ad-token-key-not-a-secret-0001
